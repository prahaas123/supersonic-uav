FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// ============================================================================

#include        "include/freeStreamVars"
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform $pInf;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $pInf;
    }

    outlet
    {
        type            zeroGradient;
    }

    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform $pInf;
    }

    uav
    {
        type            zeroGradient;
    }
}
