FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// ============================================================================

#include        "include/freeStreamVars"
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform $omegaInf;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $omegaInf;
    }

    outlet
    {
        type            zeroGradient;
    }

    farfield
    {
        type            freestream;
        freestreamValue uniform $omegaInf;
    }

    uav
    {
        type            omegaWallFunction;
        value           uniform $omegaInf;
    }
}
