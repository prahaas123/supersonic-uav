FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      rho;
}
// ============================================================================

#include        "include/freeStreamVars"
dimensions      [1 -3 0 0 0 0 0];
internalField   uniform $rhoInf;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $rhoInf;
    }

    outlet
    {
        type            zeroGradient;
    }

    farfield
    {
        type            freestream;
        freestreamValue uniform $rhoInf;
    }

    symmetry
    {
        type            symmetry;
    }

    uav
    {
        type            zeroGradient;
    }
}
