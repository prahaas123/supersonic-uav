FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// ============================================================================

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 7.3e-05;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 7.3e-05;
    }

    outlet
    {
        type            calculated;
        value           uniform 7.3e-05;
    }

    farfield
    {
        type            calculated;
        value           uniform 7.3e-05;
    }

    uav
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}
