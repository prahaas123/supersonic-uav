FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// ============================================================================

application     rhoCentralFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1e-2;
deltaT          1e-8;
writeControl    adjustable;
writeInterval   1e-3;
purgeWrite      2;
writeFormat     binary;
writePrecision  15;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       1e-4;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   10;
        log             true;
        patches         (uav);

        // Freestream reference values
        rho             rhoInf;
        rhoInf          0.1948;     // [kg/m3]
        pRef            12112;      // [Pa]

        // Aerodynamic axes
        liftDir         (0 1 0); 
        dragDir         (1 0 0);
        pitchAxis       (0 0 1);

        // Reference geometry
        CofR            (0.5 0.0 0.0);  // Centre of rotation / gravity [m]
        magUInf         442.6;          // Freestream speed [m/s]
        lRef            0.30;           // Reference chord length [m]
        Aref            0.60;           // Reference planform area [m2]
    }

    forces
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   10;
        log             true;

        patches         (uav);
        rho             rhoInf;
        rhoInf          0.1948;
        pRef            12112;
        CofR            (0.5 0.0 0.0);
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        patches         (uav);
    }

    MachNo
    {
        type            MachNo;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    Cp
    {
        type            pressure;
        libs            (fieldFunctionObjects);
        mode            staticCoeff;
        pInf            12112;
        UInf            (442.6 0 0);
        rhoInf          0.1948;
        writeControl    writeTime;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (uav); 
        writeToFile     true;
        writeControl    timeStep;
        writeInterval   10;
    }

    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (k omega);
        writeControl    timeStep;
        writeInterval   1;
    }

    convergenceControl
    {
        type            runTimeControl;
        libs            (utilityFunctionObjects);
        conditionMode   all;

        conditions
        {
            residualsConverged
            {
                type            equationInitialResidual;
                fields          (k omega p U e);
                value           1e-7;
                mode            maximum;
            }

            clCdStable
            {
                type            average;
                functionObject  forceCoeffs;
                fields          (Cl Cd);
                tolerance       1e-4;
                window          200;
                windowType      exact;
            }
        }

        satisfiedAction writeAndEnd;
    }
}
