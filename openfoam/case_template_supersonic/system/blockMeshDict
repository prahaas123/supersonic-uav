FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale 1;

vertices
(
    // Bottom face (Z = -10)
    (-10   0 -10)   //  0
    ( 20   0 -10)   //  1
    ( 20  10 -10)   //  2
    (-10  10 -10)   //  3
    // Top face (Z = +10)
    (-10   0  10)   //  4
    ( 20   0  10)   //  5
    ( 20  10  10)   //  6
    (-10  10  10)   //  7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (60 20 40) simpleGrading (1 1 1)
);

boundary
(
    inlet    { type patch;    faces ((0 4 7 3)); }
    outlet   { type patch;    faces ((1 2 6 5)); }
    symmetry { type symmetry; faces ((0 1 5 4)); }
    farfield { type patch;    faces ((3 7 6 2) (0 3 2 1) (4 5 6 7)); }
);
