FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// ============================================================================

#include        "include/flowVars"
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform $pInf;      // absolute pressure

boundaryField
{
    // Supersonic free stream: fixed at inflow faces, extrapolated at outflow faces
    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform $pInf;
        supersonic      true;
        value           uniform $pInf;
    }
    symmetry
    {
        type            symmetry;
    }
    "(airframe|inlet_lip|inlet_duct)"
    {
        type            zeroGradient;
    }
    engine_face
    {
        type            zeroGradient;
    }
    exhaust
    {
        #include        "include/exhaustPressure"
    }
}
