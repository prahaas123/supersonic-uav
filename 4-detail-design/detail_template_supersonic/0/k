FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// ============================================================================

#include        "include/flowVars"
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform $kinf;

boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue uniform $kinf;
    }
    symmetry
    {
        type            symmetry;
    }
    "(airframe|inlet_lip|inlet_duct)"
    {
        type            kqRWallFunction;
        value           uniform $kinf;
    }
    engine_face
    {
        type            inletOutlet;
        inletValue      uniform $kinf;
        value           uniform $kinf;
    }
    exhaust
    {
        type            fixedValue;
        value           uniform $kExhaust;
    }
}
