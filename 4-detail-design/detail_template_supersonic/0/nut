FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// ============================================================================

#include        "include/flowVars"
dimensions      [0 2 -1 0 0 0 0];
internalField   uniform $nutInf;

boundaryField
{
    "(farfield|engine_face|exhaust)"
    {
        type            calculated;
        value           uniform $nutInf;
    }
    symmetry
    {
        type            symmetry;
    }
    // Spalding's law covers the viscous sublayer to the log layer (all-y+ treatment)
    "(airframe|inlet_lip|inlet_duct)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}
