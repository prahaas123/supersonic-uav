FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// ============================================================================

#include        "include/flowVars"
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform $omegaInf;

boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue uniform $omegaInf;
    }
    symmetry
    {
        type            symmetry;
    }
    "(airframe|inlet_lip|inlet_duct)"
    {
        type            omegaWallFunction;
        value           uniform $omegaInf;
    }
    engine_face
    {
        type            inletOutlet;
        inletValue      uniform $omegaInf;
        value           uniform $omegaInf;
    }
    exhaust
    {
        type            fixedValue;
        value           uniform $omegaExhaust;
    }
}
