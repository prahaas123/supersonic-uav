FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}
// ============================================================================

#include        "include/flowVars"
dimensions      [1 -1 -1 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    "(farfield|engine_face|exhaust)"
    {
        type            calculated;
        value           uniform 0;
    }
    symmetry
    {
        type            symmetry;
    }
    "(airframe|inlet_lip|inlet_duct)"
    {
        type            compressible::alphatWallFunction;
        Prt             $Prt;
        value           uniform 0;
    }
}
