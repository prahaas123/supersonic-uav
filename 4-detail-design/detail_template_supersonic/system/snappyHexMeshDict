FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// ============================================================================

// Refinement levels, layer sizes and the outside point, written by supersonic_detail_run.py.
// Level n = BASE_SIZE / 2^n (0.4 m base: 3 = 50 mm, 4 = 25, 5 = 12.5, 6 = 6.25, 7 = 3.125,
// 8 = 1.5625, 9 = 0.78125, 10 = 0.390625 mm)
#include "include/meshVars"

castellatedMesh true;
snap            true;
addLayers       true;

mergeTolerance 1e-6;

geometry
{
    // One STL solid per named CAD face -> one patch each
    uav.stl
    {
        type triSurfaceMesh;
        name uav;
        regions
        {
            airframe    { name airframe; }
            inlet_lip   { name inlet_lip; }
            inlet_duct  { name inlet_duct; }
            engine_face { name engine_face; }
            exhaust     { name exhaust; }
        }
    }

    // Refinement boxes (searchableBox entries)
    #include "include/refinementBoxes"
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      150000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels $nCellsBetweenLevels;

    features
    (
        {
            file "uav.eMesh";
            level $featureLevel;
        }
    );

    refinementSurfaces
    {
        uav
        {
            level $airframeLevel;
            regions
            {
                airframe    { level $airframeLevel;    patchInfo { type wall; } }
                inlet_lip   { level $inletLipLevel;    patchInfo { type wall; } }
                inlet_duct  { level $inletDuctLevel;   patchInfo { type wall; } }
                engine_face { level $enginePortsLevel; patchInfo { type patch; } }
                exhaust     { level $enginePortsLevel; patchInfo { type patch; } }
            }
        }
    }

    resolveFeatureAngle $resolveFeatureAngle;

    refinementRegions
    {
        #include "include/refinementRegions"
    }

    locationInMesh $locationInMesh;
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

// Prism layers: first cell height and total thickness (absolute), the inlet lip and duct walls get
// fewer, thinner layers; the engine face and exhaust get none
addLayersControls
{
    relativeSizes false;
    layers
    {
        airframe
        {
            nSurfaceLayers      $nLayers;
        }
        "(inlet_lip|inlet_duct)"
        {
            nSurfaceLayers      $nLayersDuct;
            thicknessModel      firstAndOverall;
            firstLayerThickness $firstLayerThickness;
            thickness           $layerThicknessDuct;
        }
    }

    thicknessModel firstAndOverall;
    firstLayerThickness $firstLayerThickness;
    thickness $layerThickness;
    minThickness $minLayerThickness;
    nGrow 0;
    featureAngle 130;
    slipFeatureAngle 30;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minFlatness 0.5;
    minVol 1e-13;
    minTetQuality 1e-30;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    triangleTwist true;
    nSmoothScale 4;
    errorReduction 0.75;
    minTriangleTwist -1;

    relaxed
    {
        maxNonOrtho 75;
    }
}

debug 0;
