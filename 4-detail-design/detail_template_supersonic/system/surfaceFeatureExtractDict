FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// ============================================================================

// Sharp edges (> 30 deg between faces, as in the STAR-CCM+ import) and the edges between the named
// regions (lip / duct / engine face / exhaust boundaries)
uav.stl
{
    extractionMethod    extractFromSurface;

    extractFromSurfaceCoeffs
    {
        includedAngle   150;
    }

    subsetFeatures
    {
        nonManifoldEdges    yes;
        openEdges           yes;
    }

    writeObj            yes;
}
