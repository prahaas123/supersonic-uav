FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// ============================================================================

// Local time stepping (ddtSchemes localEuler): deltaT 1, so time = iteration count, and each cell
// takes its own step from maxCo. Iteration cap, write interval, Courant number, monitor interval and
// the moment reference point are written by supersonic_detail_run.py. The script also sets stopAt to
// writeNow once the asymptotic stopping criteria are met (runTimeModifiable re-reads this file).
#include "include/caseVars"

application     rhoCentralFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         $tEnd;
deltaT          1;
writeControl    timeStep;
writeInterval   $tWrite;
purgeWrite      2;
writeFormat     binary;
writePrecision  15;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;
adjustTimeStep  no;
maxCo           $maxCourant;
maxDeltaT       1;                // no cap on the local step
rDeltaTSmoothingCoeff 0.2;       // limits the local step ratio between neighbouring cells

functions
{
    // ---------------- forces on the vehicle walls (body axes, moments about the CG) ----------------
    forces
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   $monitorInterval;
        log             false;
        patches         (airframe inlet_lip inlet_duct);
        rho             rhoInf;
        rhoInf          $rhoInfRef;
        pRef            0;
        CofR            $cg;
    }
    // per-wall breakdown (pressure / viscous)
    forces_airframe
    {
        $forces;
        patches         (airframe);
    }
    forces_inlet_lip
    {
        $forces;
        patches         (inlet_lip);
    }
    forces_inlet_duct
    {
        $forces;
        patches         (inlet_duct);
    }
    // pressure force on the exhaust, for the stream-thrust (engine) bookkeeping
    forces_exhaust
    {
        $forces;
        patches         (exhaust);
    }

    // ---------------- derived fields used by the engine monitors ----------------
    MachNo
    {
        type            MachNo;
        libs            (fieldFunctionObjects);
        executeControl  timeStep;
        executeInterval $monitorInterval;
        writeControl    writeTime;
    }
    // isentropic total pressure p (1 + (gamma-1)/2 M^2)^(gamma/(gamma-1)), absolute
    totalPressure
    {
        type            pressure;
        libs            (fieldFunctionObjects);
        mode            isentropic;
        result          p0;
        executeControl  timeStep;
        executeInterval $monitorInterval;
        writeControl    writeTime;
    }

    // ---------------- engine face: sampled plane, normal +x, cell values ----------------
    // rhoU is rhoCentralFoam's conserved momentum field; as a weight field its normal component is used
    engine_face_average
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   $monitorInterval;
        log             false;
        writeFields     false;
        regionType      sampledSurface;
        name            engine_face;
        sampledSurfaceDict
        {
            type            plane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point       $efPoint;
                normal      (1 0 0);
            }
            bounds          $efBounds;
            interpolate     false;
        }
        operation       areaAverage;
        fields          (p Ma T);
    }
    // mass flow, integral of rhoU . n dA
    engine_face_mdot
    {
        $engine_face_average;
        operation       areaNormalIntegrate;
        fields          (rhoU);
    }
    // mass-weighted total pressure
    engine_face_p0
    {
        $engine_face_average;
        operation       weightedAreaAverage;
        weightField     rhoU;
        fields          (p0);
    }
    // stream thrust = integral of p dA + integral of (rhoU . n) U dA
    engine_face_pressure
    {
        $engine_face_average;
        operation       areaIntegrate;
        fields          (p);
    }
    engine_face_momentum
    {
        $engine_face_average;
        operation       weightedAreaIntegrate;
        weightField     rhoU;
        fields          (U);
    }

    // ---------------- exhaust (mass flow imposed) ----------------
    // sum(phi U): momentum flux out of the domain (signed weights)
    exhaust_momentum
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   $monitorInterval;
        log             false;
        writeFields     false;
        regionType      patch;
        name            exhaust;
        operation       weightedSum;
        weightField     phi;
        fields          (U);
    }

    // ---------------- fields for post processing (write times only) ----------------
    gradRho
    {
        type            grad;
        libs            (fieldFunctionObjects);
        field           rho;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        executeControl  writeTime;
        writeControl    writeTime;
        patches         (airframe inlet_lip inlet_duct);
    }
    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (airframe inlet_lip inlet_duct);
        writeToFile     true;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    wallHeatFlux
    {
        type            wallHeatFlux;
        libs            (fieldFunctionObjects);
        patches         (airframe inlet_lip inlet_duct);
        writeToFile     true;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U e k omega);
        writeControl    timeStep;
        writeInterval   $monitorInterval;
    }
}
