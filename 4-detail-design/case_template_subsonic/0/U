FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// ============================================================================

#include        "include/flowVars"
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform $Uinf;

boundaryField
{
    // Free stream on every outer face (Mach, p, T and flow direction from alpha / beta)
    farfield
    {
        type            freestreamVelocity;
        freestreamValue uniform $Uinf;
        value           uniform $Uinf;
    }
    symmetry
    {
        type            symmetry;
    }
    "(airframe|inlet_lip|inlet_duct|extension)"
    {
        type            noSlip;
    }
    // Outlet of the straight extension after the engine face: velocity follows from the fixed back
    // pressure, zero velocity on any backflow face (as 3-inlet-design/case_template_inlet)
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    // RDE exhaust: mass-flow inlet normal to the base (air + fuel)
    exhaust
    {
        type            flowRateInletVelocity;
        massFlowRate    $mdotExhaust;
        rho             rho;
        rhoInlet        $rhoExhaust;
        value           uniform $UExhaust;
    }
}
