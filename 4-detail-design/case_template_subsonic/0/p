FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// ============================================================================

#include        "include/flowVars"
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform $pInf;      // absolute pressure

boundaryField
{
    // Subsonic free stream: fixed at outflow faces, extrapolated at inflow faces (freestreamVelocity does the
    // opposite), so one characteristic is imposed and one leaves on each face
    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform $pInf;
        supersonic      false;
        value           uniform $pInf;
    }
    symmetry
    {
        type            symmetry;
    }
    "(airframe|inlet_lip|inlet_duct|extension)"
    {
        type            zeroGradient;
    }
    // Engine back pressure: the 1D engine-face static pressure at the design corrected mass flow with an
    // assumed recovery (PT_RECOVERY_EST in subsonic_detail_run.py), ramped down from near the engine-face
    // total pressure on a freestream start.
    // The engine-face mass flow is a result.
    outlet
    {
        #include        "include/outletPressure"
    }
    // Convergent-nozzle exhaust: zeroGradient when the exit is subsonic (exit pressure follows the ambient),
    // fixed at the sonic pressure when the nozzle chokes (written by subsonic_detail_run.py)
    exhaust
    {
        #include        "include/exhaustPressure"
    }
}
