FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Steady, pressure-based (rhoSimpleFoam). Second-order TVD (limitedLinear) convection: bounded at the sharp
// 1900 K / 870 m/s shear layer at the exhaust lip, where linearUpwind made new temperature extrema
// (350 -> 1400 K in 10 iterations) and the residuals grew (Mach 0.9, local test mesh, Nov 2026).
// A freestream start runs first on system/fvSchemes.firstOrder (subsonic_detail_run.py, FIRST_ORDER_ITERS).
ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
    limited         cellLimited Gauss linear 1;
    grad(U)         $limited;
    grad(h)         $limited;
    grad(k)         $limited;
    grad(omega)     $limited;
}

divSchemes
{
    default         none;
    div(phi,U)      bounded Gauss limitedLinearV 1;
    energy          bounded Gauss limitedLinear 1;
    div(phi,h)      $energy;
    div(phi,K)      $energy;
    div(phi,k)      bounded Gauss limitedLinear 1;
    div(phi,omega)  bounded Gauss limitedLinear 1;
    div(phid,p)     Gauss upwind;                    // transonic pressure equation
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear limited corrected 0.5;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited corrected 0.5;
}

wallDist
{
    method meshWave;
}

