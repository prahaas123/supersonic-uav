FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-10;
        relTol          0.05;
    }

    "(U|h|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    // SIMPLEC with the compressible (transonic) pressure equation: local supersonic pockets at Mach 0.8-0.9
    // and the choked exhaust need the convective p term, and it reduces to the usual form at low Mach.
    // Off (plain SIMPLE, p relaxed 0.3) since Nov 2026: with them on, Mach 0.5 grew an engine-face pressure /
    // mass-flow oscillation from iteration ~150-300 that clipped p at pMax, even at U/h relaxation 0.3.
    // Mach 0.1-0.3 and 0.9 converged with them on (consistent yes, transonic yes, p 1, U/h 0.5).
    consistent      no;
    transonic       no;
    // p kept between 0.1 x the lowest and 3 x the highest fixed boundary pressure
    pMinFactor      0.1;
    pMaxFactor      3;
    // no residualControl: subsonic_detail_run.py stops on the asymptotes of the forces and the engine mass flow
}

relaxationFactors
{
    fields
    {
        p               0.3;          // plain SIMPLE needs explicit p relaxation
    }
    equations
    {
        // p listed so that pEqn.relax() keeps the transonic p matrix diagonally dominant
        // (3-inlet-design: without it the first p solve hit NaN)
        p               1;
        // 0.5: at 0.7 a pressure disturbance grew along the hot exhaust plume and diverged by
        // iteration 76 (Mach 0.9, local test mesh, Nov 2026)
        U               0.5;
        "(h|e)"         0.5;
        "(k|omega)"     0.5;
    }
}

wallDist
{
    method meshWave;
}

