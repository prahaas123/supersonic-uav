FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// ============================================================================

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.05;
    }

    "(U|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    // SIMPLEC with the compressible (transonic) p equation; the capture plane runs at M ~0.55-0.6.
    consistent      yes;
    transonic       yes;
    pMinFactor      0.5;
    pMaxFactor      1.5;

    residualControl
    {
        p               1e-6;
        U               1e-6;
        e               1e-6;
        "(k|omega)"     1e-6;
    }
}

relaxationFactors
{
    fields
    {
        p               1;            // SIMPLEC needs no explicit p relaxation
    }
    equations
    {
        // Required with transonic yes: pEqn.relax() only enforces diagonal dominance of the
        // p matrix when p is listed here. Without it, the first p solve from U = 0 hit NaN
        // (inlet_T1-T3 crashed with SIGFPE on iteration 1).
        p               1;
        U               0.7;
        e               0.7;
        "(k|omega)"     0.7;
    }
}

