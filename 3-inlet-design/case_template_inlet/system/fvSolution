FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// ============================================================================

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.05;
    }

    "(U|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      no;           // set by run_inlet.py (SOLVER_VARIANTS)
    transonic       no;           // set by run_inlet.py (SOLVER_VARIANTS), yes uses div(phid,p)
    pMinFactor      0.5;
    pMaxFactor      1.5;

    residualControl
    {
        p               1e-6;
        U               1e-6;
        e               1e-6;
        "(k|omega)"     1e-6;
    }
}

relaxationFactors
{
    // p, rho, U and e are set by run_inlet.py (SOLVER_VARIANTS)
    fields
    {
        p               0.3;
        rho             0.05;
    }
    equations
    {
        U               0.5;
        e               0.7;
        "(k|omega)"     0.7;
    }
}

