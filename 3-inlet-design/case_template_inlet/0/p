FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// ============================================================================

#include        "include/initialConditions"
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform $pOut;

boundaryField
{
    inlet
    {
        // Capture total pressure is a result: U fixes the mass flow here
        type            zeroGradient;
    }
    outlet
    {
        // Engine back pressure, 1D estimate with an assumed duct recovery (set by run_inlet.py)
        type            fixedValue;
        value           uniform $pOut;
    }
    "(wall|extension)"
    {
        type            zeroGradient;
    }
    background
    {
        type            zeroGradient;
    }
}
