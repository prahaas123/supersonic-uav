FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// ============================================================================

#include        "include/initialConditions"
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);     // start from rest, a uniform x-velocity diverged in the S-bend

boundaryField
{
    inlet
    {
        // Velocity follows from the total pressure at the capture plane and the outlet back pressure.
        // An imposed mass flow here (flowRateInletVelocity + zeroGradient p) fell into a limit cycle
        // at full mass flow (inlet_baseline, Nov 2026).
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform $UInit;
    }
    "(wall|extension)"
    {
        type            noSlip;
    }
    background
    {
        type            zeroGradient;
    }
}
