FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// ============================================================================

#include        "include/initialConditions"
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);     // start from rest, a uniform x-velocity diverged in the S-bend

boundaryField
{
    inlet
    {
        // Engine demand imposed at the capture plane, ramped up from rest (table set by run_inlet.py).
        // Velocity in + pressure out is well posed; a velocity outlet with zeroGradient p was not.
        type            flowRateInletVelocity;
        massFlowRate    table ((0 0.0527) (1500 0.2635));
        rho             rho;
        rhoInlet        0.5;            // only used before rho exists on the patch
        extrapolateProfile no;
        value           uniform $UInit;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform $UInit;
    }
    "(wall|extension)"
    {
        type            noSlip;
    }
    background
    {
        type            zeroGradient;
    }
}
