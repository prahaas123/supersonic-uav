FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// ============================================================================

#include        "include/initialConditions"
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);     // start from rest, a uniform x-velocity diverged in the S-bend

boundaryField
{
    inlet
    {
        type            pressureInletOutletVelocity;
        value           uniform $UInit;
    }
    outlet
    {
        // Engine demand: fixed mass flow, ramped up from rest (table set by run_inlet.py)
        type            flowRateOutletVelocity;
        massFlowRate    table ((0 0.0527) (1500 0.2635));
        rho             rho;
        value           uniform $UInit;
    }
    "(wall|extension)"
    {
        type            noSlip;
    }
    background
    {
        type            zeroGradient;
    }
}
