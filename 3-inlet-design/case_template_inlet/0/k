FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// ============================================================================

#include        "include/initialConditions"
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform $kInit;

boundaryField
{
    inlet
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       $turbIntensity;
        value           uniform $kInit;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform $kInit;
        value           uniform $kInit;
    }
    "(wall|extension)"
    {
        type            kqRWallFunction;
        value           uniform $kInit;
    }
    background
    {
        type            zeroGradient;
    }
}
